{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "tensura:spirit_wind",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/sylphide/sylphide"
      },
      "geometry": {
        "default": "geometry.sylphide"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "animations": {
        "idle": "animation.sylphide.idle",
        "walk": "animation.sylphide.fly"
      },
      "scripts": {
        "animate": [
          {
            "walk": "query.modified_move_speed > 0.02"
          },
          {
            "idle": "query.modified_move_speed <= 0.02"
          }
        ]
      }
    }
  }
}